# Скопируйте в .env и заполните. .env в git и в Docker-образ не попадает.

# --- LLM (OpenRouter, OpenAI-совместимый API) ---
LLM__API_KEY=                              # https://openrouter.ai/keys — обязательно (без него сервис не стартует)
LLM__BASE_URL=https://openrouter.ai/api/v1
LLM__DEFAULT_MODEL=openai/gpt-5.4-mini     # primary
LLM__FALLBACK_MODEL=anthropic/claude-haiku-4.5   # fallback другого вендора; пусто — без fallback
LLM__LOCAL_BASE_URL=http://localhost:11434/v1    # Ollama на этой машине; пусто — без локального fallback
LLM__LOCAL_MODEL=gemma3:4b
LLM__REQUEST_TIMEOUT=30                    # таймаут HTTP-запроса в SDK, с
LLM__CALL_TIMEOUT=15                       # дедлайн попытки у одного провайдера, с
LLM__MAX_RETRIES=3                         # ретраи SDK на 429/5xx
LLM__MAX_CONCURRENCY=5                     # одновременных LLM-вызовов на процесс

# --- Промпты ---
PROMPT_VERSION=v1
PRODUCT_NAME=Финпомощник

# --- HTTP-сервис ---
REDIS_URL=redis://127.0.0.1:6379/0         # в docker compose переопределяется на redis://redis:6379/0
CACHE_TTL_SECONDS=3600
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
LOG_LEVEL=INFO
APP_PORT=8000                              # порт на хосте для docker compose

# --- Чат и история (Б4.1) ---
CHAT_REPOSITORY=postgres                   # json | postgres
CHAT_STORAGE_DIR=./var/chats               # для CHAT_REPOSITORY=json
CHAT_CONTEXT_STRATEGY=sliding
CHAT_CONTEXT_WINDOW=10                     # сообщений истории в контексте
LLM_CONTEXT_TOKENS=16000                   # бюджет: CONTEXT − RESPONSE − SAFETY
LLM_RESPONSE_TOKENS=1024
LLM_SAFETY_MARGIN_TOKENS=512

# --- Postgres ---
POSTGRES_USER=fin
POSTGRES_PASSWORD=                         # сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(18))"
POSTGRES_DB=fin
DATABASE_URL=postgresql+asyncpg://fin:<пароль>@127.0.0.1:5433/fin   # с хоста; в compose переопределяется на postgres:5432

# --- Telegram-бот (Б4.2) ---
BOT_TOKEN=                                 # от @BotFather — секрет, в git не коммитится
BACKEND_URL=http://127.0.0.1:8010          # в compose переопределяется на http://app:8000
BOT_ADMIN_IDS=                             # Telegram ID админов через запятую (узнать у @userinfobot)
