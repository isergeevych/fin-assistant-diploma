# Скопируйте в .env и заполните. .env в git не попадает.

# --- LLM (OpenRouter, OpenAI-совместимый API) ---
LLM__API_KEY=                              # https://openrouter.ai/keys — обязательно
LLM__BASE_URL=https://openrouter.ai/api/v1
LLM__DEFAULT_MODEL=openai/gpt-5.4-mini
LLM__REQUEST_TIMEOUT=30

# --- Промпты ---
PROMPT_VERSION=v1
PRODUCT_NAME=Финпомощник
