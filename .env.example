# Скопируйте в .env и заполните. .env в git и в Docker-образ не попадает.

# --- LLM (OpenRouter, OpenAI-совместимый API) ---
LLM__API_KEY=                              # https://openrouter.ai/keys — обязательно (без него сервис не стартует)
LLM__BASE_URL=https://openrouter.ai/api/v1
LLM__DEFAULT_MODEL=openai/gpt-5.4-mini     # primary
LLM__FALLBACK_MODEL=anthropic/claude-haiku-4.5   # fallback другого вендора; пусто — без fallback
LLM__LOCAL_BASE_URL=http://localhost:11434/v1    # Ollama на этой машине; пусто — без локального fallback
LLM__LOCAL_MODEL=gemma3:4b
LLM__REQUEST_TIMEOUT=30                    # таймаут HTTP-запроса в SDK, с
LLM__CALL_TIMEOUT=15                       # дедлайн попытки у одного провайдера, с
LLM__MAX_RETRIES=3                         # ретраи SDK на 429/5xx
LLM__MAX_CONCURRENCY=5                     # одновременных LLM-вызовов на процесс

# --- Промпты ---
PROMPT_VERSION=v1
PRODUCT_NAME=Финпомощник

# --- HTTP-сервис ---
REDIS_URL=redis://127.0.0.1:6379/0         # в docker compose переопределяется на redis://redis:6379/0
CACHE_TTL_SECONDS=3600
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
LOG_LEVEL=INFO
APP_PORT=8000                              # порт на хосте для docker compose

# --- Чат и история (Б4.1) ---
CHAT_REPOSITORY=postgres                   # json | postgres
CHAT_STORAGE_DIR=./var/chats               # для CHAT_REPOSITORY=json
CHAT_CONTEXT_STRATEGY=sliding
CHAT_CONTEXT_WINDOW=10                     # сообщений истории в контексте
LLM_CONTEXT_TOKENS=16000                   # бюджет: CONTEXT − RESPONSE − SAFETY
LLM_RESPONSE_TOKENS=1024
LLM_SAFETY_MARGIN_TOKENS=512

# --- Postgres ---
POSTGRES_USER=fin
POSTGRES_PASSWORD=                         # сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(18))"
POSTGRES_DB=fin
DATABASE_URL=postgresql+asyncpg://fin:<пароль>@127.0.0.1:5433/fin   # с хоста; в compose переопределяется на postgres:5432

# --- Telegram-бот (Б4.2) ---
BOT_TOKEN=                                 # от @BotFather — секрет, в git не коммитится
BACKEND_URL=http://127.0.0.1:8010          # в compose переопределяется на http://app:8000
BOT_ADMIN_IDS=                             # Telegram ID админов через запятую (узнать у @userinfobot)

# --- Мультимодальность и обратный канал (Б4.3) ---
OPENAI_API_KEY=                            # только для Whisper (голос → текст); пусто — голосовые отклоняются (503)
INTERNAL_TOKEN=                            # общий секрет app <-> bot: python -c "import secrets;print(secrets.token_urlsafe(24))"
BOT_URL=http://bot:9000
BOT_API_PORT=9000
STREAM_MODE=draft                          # draft (sendMessageDraft) | edit (edit_text)

# --- Production-обвязка (Б4.4) ---
MODERATION_ENABLED=true
ADMIN_TOKEN=                               # X-Admin-Token для /chats/admin/*: python -c "import secrets;print(secrets.token_urlsafe(24))"
BROADCAST_POLL_SEC=15

# --- Эмбеддинги (Б5.1) ---
EMBEDDING_BASE_URL=http://localhost:11434/v1   # Ollama; облако: https://openrouter.ai/api/v1 (+ EMBEDDING_API_KEY)
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b           # ollama pull qwen3-embedding:0.6b
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=64

# --- Qdrant (Б5.2) ---
QDRANT_URL=http://127.0.0.1:6333            # в compose переопределяется на http://qdrant:6333
QDRANT_API_KEY=                             # обязателен даже на dev: python -c "import secrets;print(secrets.token_urlsafe(24))"
QDRANT_COLLECTION=documents
EMBEDDING_DIM=1024                          # должно совпадать с моделью эмбеддингов (qwen3-embedding 0.6B → 1024)

# --- RAG (Б5.3) ---
RAG_ENABLED=true
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.35
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_LLM_BASE_URL=                          # пусто → основной LLM; локально: http://localhost:11434/v1
RAG_LLM_MODEL=                             # локально: qwen3:8b (gemma3:4b для строгого RAG слишком слаба)
RAG_LLM_API_KEY=
RAG_LLM_BASE_URL_DOCKER=                   # то же для контейнера: http://host.docker.internal:11434/v1

# --- Оценка RAG (Б5.6) ---
EVAL_JUDGE_BASE_URL=                       # пусто → RAG-LLM; в облаке судья сильнее production-модели
EVAL_JUDGE_MODEL=
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_REASONING_EFFORT=                # gemini: low (reasoning не выключается)
PHOENIX_LLAMAINDEX_TRACING=false           # true → дерево query → retrieve → LLM в Phoenix (extra tracing)

# --- Агенты (модуль 6) ---
AGENT_BASE_URL=                            # пусто → основной LLM (gpt-5.4-mini); локально: http://localhost:11434/v1
AGENT_MODEL=                               # локально: qwen3:8b
AGENT_API_KEY=
AGENT_REASONING_EFFORT=                    # qwen3: none
AGENT_PREMIUM_MODEL=openai/gpt-5.4          # Б6.2: генерация после замечания критика

# --- Персистентный агент с подтверждением (Б6.4) ---
AGENT_CHECKPOINTER=sqlite                  # memory | sqlite | postgres (в docker-compose — postgres)
AGENT_DEFAULT_ROLE=write-with-approve      # read-only | write-with-approve | full
SMTP_HOST=127.0.0.1                        # Mailpit (в compose — mailpit); письма видны на http://127.0.0.1:8025
SMTP_PORT=1025

# --- Лимиты на пользователя (время тестов; 0 — выключено) ---
USAGE_DAILY_USD=1.0                        # реальная стоимость из ответа OpenRouter, сутки по Москве
USAGE_DAILY_TOKENS=50000                   # input + output по всем вызовам модели ради сообщений
USAGE_RATE_PER_MINUTE=10
# админы (BOT_ADMIN_IDS выше) — без лимитов, их траты видны в 📊 Статистике
