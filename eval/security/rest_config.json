{
  "rest": {
    "RestGenerator": {
      "name": "fin-assistant-chat",
      "uri": "http://localhost:8000/chat",
      "method": "post",
      "headers": {"Content-Type": "application/json"},
      "req_template_json_object": {
        "messages": [{"role": "user", "content": "$INPUT"}],
        "max_tokens": 400
      },
      "response_json": true,
      "response_json_field": "content",
      "skip_codes": [400, 502],
      "request_timeout": 90
    }
  }
}
